# 统一换行符，避免 Windows 下 autocrlf 造成的 diff 噪音
* text=auto eol=lf

# Go 源码统一 LF
*.go   text eol=lf
*.mod  text eol=lf
*.sum  text eol=lf
*.md   text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf

# Windows 脚本保留 CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf

# 二进制文件
*.exe  binary
*.png  binary
*.jpg  binary
*.zip  binary
